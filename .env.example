# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN="TOKEN_DISCORD"

# Concurrence et file d'attente
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUE_SIZE=20
MAX_ACTIVE_DOWNLOADS_PER_USER=1
DOWNLOAD_COOLDOWN=15
DOWNLOAD_TIMEOUT=600

# Répertoires
TEMP_DIRECTORY=./tmp
DOWNLOADS_DIRECTORY=./downloads

# Fallback pour les fichiers trop volumineux pour Discord
STORAGE_PROVIDER=local
FILE_RETENTION_MINUTES=10
# 25 Mo par défaut (serveurs sans boost) ; augmente selon le niveau de boost de ton serveur
DISCORD_MAX_FILE_SIZE=26214400

# Serveur HTTP interne qui sert les liens temporaires (fallback)
PUBLIC_BASE_URL=http://localhost:8080
FALLBACK_SERVER_HOST=0.0.0.0
FALLBACK_SERVER_PORT=8080

# Optionnel
FFMPEG_LOCATION=
COOKIES_FILE=
LOG_LEVEL=INFO
